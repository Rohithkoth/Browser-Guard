   {
     "manifest_version": 3,
     "name": "YouTube Shorts Hider",
     "version": "0.1.0",
     "content_scripts": [
       {
         "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
         "css": ["hide-shorts.css"],
         "run_at": "document_start"
       }
     ]
   }